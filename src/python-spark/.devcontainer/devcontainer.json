{
  "name": "Python Spark",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USER_ID": "1000",
      "GROUP_ID": "1000"
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "spark",
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/spark/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.claude,target=/home/spark/.claude,type=bind"
  ],
  "forwardPorts": [15002, 4040],
  "portsAttributes": {
    "15002": { "label": "Spark Connect", "onAutoForward": "silent" },
    "4040": { "label": "Spark UI", "onAutoForward": "notify" }
  },
  "postStartCommand": "([ -f pyproject.toml ] && uv sync || true) && /opt/spark/sbin/start-connect-server.sh",
  "remoteEnv": {
    "LOCAL_USER_ID": "${localEnv:USER_ID}",
    "UV_LINK_MODE": "copy",
    "UV_CACHE_DIR": "/tmp/uv-cache",
    "SPARK_REMOTE_URL": "sc://localhost:15002"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "mhutchie.git-graph",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [120],
        "files.insertFinalNewline": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "/bin/zsh", "args": ["-i"] }
        },
        "terminal.integrated.fontFamily": "MesloLGS NF, Fira Code, monospace"
      }
    }
  }
}
